        ],
        "summary": "The OpenAPI 3.1 description of this API.",
        "description": "Generated from route metadata at boot — never hand-written. Requires no credentials: a specification a consumer cannot fetch before authenticating is a specification they cannot use to authenticate.",
        "security": [],
        "responses": {
          "200": {
            "description": "The OpenAPI 3.1 description of this API.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
