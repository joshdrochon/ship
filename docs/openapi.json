                }
              }
            }
          },
          "403": {
            "description": "The token is valid but was not granted `documents:write`. The body names the missing scope, the granted scopes, and what the missing one permits.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "422": {
            "description": "The request did not validate. `details.fields[]` names each problem.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
