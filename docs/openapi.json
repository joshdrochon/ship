{
  "openapi": "3.1.0",
  "info": {
    "title": "Ship Public API",
    "version": "1.0.0",
    "description": "The public, versioned Ship platform API.\n\nGenerated from route metadata — every operation below is produced by the same `declareV1Route()` call that mounts its Express handler, so an endpoint cannot exist without appearing here and cannot appear here without existing."
  },
  "servers": [
    {
      "url": "/api/v1",
      "description": "This deployment."
    }
  ],
  "components": {
    "securitySchemes": {
      "shipOAuth2": {
        "type": "oauth2",
        "description": "OAuth 2.0 access token, presented as `Authorization: Bearer <token>`. Every operation lists the scopes it requires.",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "/oauth/authorize",
            "tokenUrl": "/oauth/token",
            "refreshUrl": "/oauth/token",
            "scopes": {
              "documents:read": "Read documents in your workspace",
              "documents:write": "Create and update documents in your workspace",
              "issues:read": "Read issues in your workspace",
              "issues:write": "Create and update issues in your workspace",
              "sprints:read": "Read sprints in your workspace",
              "sprints:write": "Create and update sprints in your workspace",
              "webhooks:manage": "Create, update and delete webhook subscriptions"
            }
          },
          "clientCredentials": {
            "tokenUrl": "/oauth/token",
            "scopes": {
              "documents:read": "Read documents in your workspace",
              "documents:write": "Create and update documents in your workspace",
              "issues:read": "Read issues in your workspace",
              "issues:write": "Create and update issues in your workspace",
              "sprints:read": "Read sprints in your workspace",
              "sprints:write": "Create and update sprints in your workspace",
              "webhooks:manage": "Create, update and delete webhook subscriptions"
            }
          }
        }
      }
    },
