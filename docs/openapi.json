                      ],
                      "additionalProperties": false
                    },
                    "scopes": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "enum": [
                          "documents:read",
                          "documents:write",
                          "issues:read",
                          "issues:write",
                          "sprints:read",
                          "sprints:write",
                          "webhooks:manage"
                        ]
