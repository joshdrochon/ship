                        "type"
                      ]
                    }
                  },
                  "properties": {
                    "type": "object",
                    "additionalProperties": {}
                  },
                  "visibility": {
                    "type": "string",
                    "enum": [
                      "private",
                      "workspace"
                    ]
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Create a document.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "document_type": {
                      "type": "string",
                      "enum": [
