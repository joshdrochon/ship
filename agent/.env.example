# FleetGraph agent — copy to .env and fill in. .env is gitignored; never commit it.

# Ship's database. The agent reads Ship state directly (PRESEARCH.md Q1) and
# stores its own tables alongside (Q19), so this is one connection string, not two.
DATABASE_URL=postgresql://ship:ship_dev_password@localhost:5433/ship_dev

# Ship's HTTP API, for actions only. Detection never goes through it.
# Without a token the agent still detects and notifies; it just cannot comment.
SHIP_API_URL=http://localhost:3000
SHIP_API_TOKEN=

# ── LangSmith (FG-176) ──────────────────────────────────────────────────────
# Tracing is what makes MVP requirement 2 demonstrable: a quiet run and a
# drifting run produce visibly different traces from the same graph.
#
# LANGCHAIN_TRACING_V2 must be the literal string "true". LangChain checks the
# string, so "1", "yes", and true-without-a-key all silently disable tracing —
# and a disabled tracer looks exactly like a graph that never ran.
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
# Groups runs in the LangSmith UI. Set it per environment so a local experiment
# does not land in the same project as the deployed cron's traces.
LANGCHAIN_PROJECT=fleetgraph-local

# ── Bedrock ─────────────────────────────────────────────────────────────────
# Unset in dev to use the real provider via the ambient AWS credential chain.
# Point it at the mock in CI (see mocks/bedrock-expectations.json).
# BEDROCK_ENDPOINT=http://localhost:8081

# Scan a single workspace instead of every one. What makes the timed latency
# test (FG-209) and local verification possible without a full sweep.
# FLEETGRAPH_WORKSPACE_ID=
