# FleetGraph agent — copy to .env and fill in. .env is gitignored; never commit it.

# Ship's database. The agent reads Ship state directly (PRESEARCH.md Q1) and
# stores its own tables alongside (Q19), so this is one connection string, not two.
DATABASE_URL=postgresql://ship:ship_dev_password@localhost:5433/ship_dev

# Ship's HTTP API, for actions only. Detection never goes through it.
# Without a token the agent still detects and notifies; it just cannot comment.
SHIP_API_URL=http://localhost:3000
SHIP_API_TOKEN=

# ── LangSmith (FG-176) ──────────────────────────────────────────────────────
# Tracing is what makes MVP requirement 2 demonstrable: a quiet run and a
# drifting run produce visibly different traces from the same graph.
#
# LANGCHAIN_TRACING_V2 must be the literal string "true". LangChain checks the
# string, so "1", "yes", and true-without-a-key all silently disable tracing —
# and a disabled tracer looks exactly like a graph that never ran.
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
# Traces upload on a background queue by default. A cron process exits before
# that queue drains, so the run succeeds and LangSmith stays empty. The code
# defaults this to false; set it to true only on a long-running host.
LANGCHAIN_CALLBACKS_BACKGROUND=false
# Groups runs in the LangSmith UI. Set it per environment so a local experiment
# does not land in the same project as the deployed cron's traces.
LANGCHAIN_PROJECT=fleetgraph-local

# ── The model ───────────────────────────────────────────────────────────────
# Without one of the two below, the agent still runs and still detects — but
# judgement returns ai_unavailable, the watermark is held, and nothing ever
# reaches a human. Detection without judgement is not a working agent.
#
# Precedence: BEDROCK_ENDPOINT > ANTHROPIC_API_KEY > ambient AWS credentials.
# The mock wins deliberately, so a key sitting in a CI environment cannot turn a
# deterministic suite into a billed one.

# Primary. This is what the deployed cron uses (terraform var anthropic_api_key).
ANTHROPIC_API_KEY=

# Optional override, for a key without access to the default model. The default
# is claude-opus-4-5-20251101.
# FLEETGRAPH_MODEL_ID=

# ── Bedrock ─────────────────────────────────────────────────────────────────
# The fallback, and the mock seam. Set it to point at the local fake in CI and
# under ./start.sh (see mocks/bedrock-expectations.json); leave it unset
# otherwise. Unset with no ANTHROPIC_API_KEY means the ambient AWS credential
# chain, which resolves to nothing on Render — that was the original problem.
# BEDROCK_ENDPOINT=http://localhost:8081

# Scan a single workspace instead of every one. What makes the timed latency
# test (FG-209) and local verification possible without a full sweep.
# FLEETGRAPH_WORKSPACE_ID=
