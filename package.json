{
  "name": "ship",
  "version": "0.0.0",
  "private": true,
  "description": "Ship monorepo - API + Web + Shared types",
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "./scripts/dev.sh",
    "docker:up": "docker compose -f docker-compose.local.yml up --build",
    "docker:down": "docker compose -f docker-compose.local.yml down",
    "docker:clean": "docker compose -f docker-compose.local.yml down -v",
    "dev:raw": "pnpm --parallel --recursive run dev",
    "dev:api": "pnpm --filter @ship/api dev",
    "dev:web": "pnpm --filter @ship/web dev",
    "dev:shared": "pnpm --filter @ship/shared dev",
    "build": "pnpm --recursive run build",
    "build:shared": "pnpm --filter @ship/shared build",
    "build:agent": "pnpm run build:shared && pnpm --filter @ship/agent build",
    "build:api": "pnpm run build:agent && pnpm --filter @ship/api build",
    "build:web": "pnpm run build:shared && pnpm --filter @ship/web build",
    "type-check": "pnpm --recursive run type-check",
    "lint": "eslint .",
    "lint:boundary": "node scripts/check-boundary-lint.mjs",
    "drill:refresh": "pnpm --filter @ship/integration-testkit build && tsx scripts/l24-drill-server.ts --package @ship/drill-refresh-rotation --expired-instance",
    "drill:idempotency": "pnpm --filter @ship/integration-testkit build && tsx scripts/l24-drill-server.ts --package @ship/drill-idempotency --allow-loopback-webhooks",
    "check:integration-deps": "node scripts/check-integration-deps.mjs",
    "check:integration-credentials": "node scripts/check-integration-credentials.mjs",
    "baseline:measure": "pnpm --filter @ship/api exec tsx src/scripts/measure-baseline.ts",
    "baseline:compare": "pnpm --filter @ship/api exec tsx src/scripts/compare-baseline.ts",
    "baseline:evidence": "node api/src/scripts/seed-regression-evidence.mjs",
    "clean": "pnpm --recursive run clean && rm -rf node_modules",
    "test": "pnpm --workspace-concurrency=1 --filter @ship/shared --filter @ship/api --filter @ship/agent --filter @ship/sdk test",
    "drill": "node scripts/ttfe/drill.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "worktree:init": "./scripts/worktree-init.sh",
    "db:seed": "pnpm --filter @ship/api db:seed",
    "db:migrate": "pnpm --filter @ship/api db:migrate",
    "openapi:public": "pnpm --filter @ship/api openapi:public",
    "db:orphan-check": "pnpm --filter @ship/api db:orphan-check",
    "prepare": "husky",
    "postinstall": "git config merge.ours.driver true && (command -v comply >/dev/null 2>&1 || echo '\\n\u26a0\ufe0f  comply CLI not installed - pre-commit hooks require it\\n   Install with: pip install comply-cli\\n')",
    "lint:fix": "eslint . --fix",
    "test:all": "pnpm --recursive run test",
    "test:coverage": "pnpm --recursive run test:coverage",
    "licenses": "pnpm licenses list --json > licenses.json && node scripts/license-inventory.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@eslint/js": "10.0.1",
    "@guidepup/guidepup": "0.29.2",
    "@guidepup/virtual-screen-reader": "0.32.1",
    "@playwright/test": "1.57.0",
    "@testcontainers/postgresql": "11.11.0",
    "@types/supertest": "6.0.3",
    "@vitest/ui": "4.1.10",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "get-port": "7.1.0",
    "globals": "17.8.0",
    "husky": "9.1.7",
    "prettier": "3.7.4",
    "supertest": "7.2.2",
    "testcontainers": "11.11.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  },
  "pnpm": {
    "overrides": {
      "fast-xml-parser": "5.10.1",
      "protobufjs": "8.7.1",
      "vitest": "4.1.10"
    }
  }
}
