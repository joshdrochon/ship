{
  "name": "@ship/slack",
  "version": "0.1.0",
  "private": true,
  "description": "PRD p.8 option 2 (should-ship) — an Express + @slack/bolt listener that installs via Slack OAuth, verifies Ship's signature over the raw body, and posts two event types. Imports ONLY @ship/sdk.",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -b",
    "start": "node dist/index.js",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "type-check": "tsc -b",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts"
  },
  "dependencies": {
    "@ship/sdk": "workspace:*",
    "@slack/web-api": "8.0.0",
    "express": "5.2.1"
  },
  "devDependencies": {
    "@ship/integration-testkit": "workspace:*",
    "@types/express": "5.0.0",
    "@types/node": "22.19.5",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
