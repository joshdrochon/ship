{
  "name": "@ship/api",
  "version": "0.0.0",
  "private": true,
  "description": "Express API server",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && cp src/db/schema.sql dist/db/schema.sql && cp -r src/db/migrations dist/db/migrations",
    "start": "node dist/index.js",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:seed": "tsx src/db/seed.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:orphan-check": "tsx src/db/scripts/orphan-diagnostic.ts",
    "openapi:generate": "tsx src/scripts/generate-openapi.ts",
    "mcp": "tsx src/mcp/server.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "7",
    "@aws-sdk/client-bedrock-runtime": "3.987.0",
    "@aws-sdk/client-s3": "3.985.0",
    "@aws-sdk/client-secrets-manager": "3.985.0",
    "@aws-sdk/client-ssm": "3.985.0",
    "@aws-sdk/s3-request-presigner": "3.985.0",
    "@modelcontextprotocol/sdk": "1.26.0",
    "@ship/shared": "workspace:*",
    "bcryptjs": "3.0.3",
    "cookie": "1.1.1",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "csrf-sync": "4.2.1",
    "dotenv": "16.6.1",
    "express": "4.22.1",
    "express-rate-limit": "8.2.1",
    "express-session": "1.18.2",
    "helmet": "8.1.0",
    "lib0": "0.2.117",
    "openid-client": "6.8.1",
    "pg": "8.16.3",
    "swagger-ui-express": "5.0.1",
    "uuid": "11.1.0",
    "ws": "8.19.0",
    "y-protocols": "1.0.7",
    "y-websocket": "2.1.0",
    "yjs": "13.6.29",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "3.0.0",
    "@types/cookie": "1.0.0",
    "@types/cookie-parser": "1.4.10",
    "@types/cookiejar": "2.1.5",
    "@types/cors": "2.8.19",
    "@types/docker-modem": "3.0.6",
    "@types/dockerode": "3.3.47",
    "@types/express": "5.0.6",
    "@types/express-session": "1.18.2",
    "@types/methods": "1.1.4",
    "@types/node": "22.19.5",
    "@types/pg": "8.16.0",
    "@types/ssh2": "1.15.5",
    "@types/superagent": "8.1.9",
    "@types/supertest": "6.0.3",
    "@types/swagger-ui-express": "4.1.8",
    "@types/ws": "8.18.1",
    "@vitest/coverage-v8": "4.0.17",
    "@vitest/ui": "4.0.17",
    "openapi3-ts": "4.5.0",
    "supertest": "7.2.2",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
